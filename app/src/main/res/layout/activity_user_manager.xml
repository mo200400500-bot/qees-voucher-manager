<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E8EEF9"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- شريط العنوان العلوي -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingVertical="6dp">

            <TextView
                android:id="@+id/tvConnectionStatus"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="• متصل بالمايكروتك"
                android:textColor="#15803D"
                android:textSize="12sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="يوزر منجر"
                    android:textColor="#0F172A"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="RouterOS v6 — /tool user-manager"
                    android:textColor="#475569"
                    android:textSize="12sp" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/btnBackUserManager"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="رجوع"
                android:src="@android:drawable/ic_menu_revert" />
        </LinearLayout>

        <!-- تبويبات يوزر منجر -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp">

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none">

                <com.google.android.material.button.MaterialButtonToggleGroup
                    android:id="@+id/umTabsGroup"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:padding="6dp"
                    app:checkedButton="@+id/btnTabPrintCards"
                    app:selectionRequired="true"
                    app:singleSelection="true">

                    <Button
                        android:id="@+id/btnTabSingleCard"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:text="بطاقة واحدة"
                        android:textSize="12sp" />

                    <Button
                        android:id="@+id/btnTabPrintCards"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:text="طباعة كروت"
                        android:textSize="12sp" />

                    <Button
                        android:id="@+id/btnTabUsers"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:text="المستخدمين"
                        android:textSize="12sp" />

                    <Button
                        android:id="@+id/btnTabProfiles"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:text="الباقات"
                        android:textSize="12sp" />
                </com.google.android.material.button.MaterialButtonToggleGroup>
            </HorizontalScrollView>
        </com.google.android.material.card.MaterialCardView>

        <!-- أزرار القالب والنماذج وإعادة الضبط -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnResetTemplate"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:text="إعادة الضبط"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnReadyTemplates"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginHorizontal="6dp"
                android:layout_weight="1"
                android:text="نماذج جاهزة"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnPhoneTemplate"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:text="قالب من الهاتف"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- معاينة الكرت -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            app:cardBackgroundColor="#0F172A"
            app:cardCornerRadius="14dp"
            app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="14dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="end"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvCardNetworkTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="بطاقة دخول الإنترنت"
                        android:textColor="#FACC15"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvCardCodePreview"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:background="#FFFFFF"
                        android:gravity="center"
                        android:padding="8dp"
                        android:text="12345678"
                        android:textColor="#0F172A"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvCardDetailsPreview"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="الباقة: 100 • ملاحظات 1: مفعّل"
                        android:textColor="#E2E8F0"
                        android:textSize="12sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvQrBox"
                    android:layout_width="86dp"
                    android:layout_height="86dp"
                    android:layout_marginStart="12dp"
                    android:background="#FFFFFF"
                    android:gravity="center"
                    android:padding="6dp"
                    android:text="QR\nCODE"
                    android:textColor="#0F172A"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- إعدادات الكرت -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="إعدادات الكرت"
                    android:textColor="#0F172A"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:hint="الباقة">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etPackageName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="100" />
                </com.google.android.material.textfield.TextInputLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:hint="طول الاسم">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etCodeLength"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="number"
                            android:text="8" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:hint="نوع الاسم">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etCodeType"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="أرقام" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:hint="كلمة السر">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etPasswordMode"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="بدون" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:hint="عدد الكروت">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etCardsCount"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number"
                        android:text="20" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:hint="نقطة البيع">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etPointOfSale"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="لا يوجد" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- مفاتيح خيارات الكرت -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/swQuota"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="حجم الرصيد" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/swPrice"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="السعر" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/swComment1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="ملاحظات 1" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/swComment2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="ملاحظات 2" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/swSerial"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="رقم تسلسلي" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/swBindFirstUse"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="ربط عند أول استخدام" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/tvGridCapacity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="#E0E7FF"
            android:gravity="center"
            android:padding="8dp"
            android:text="يمكن للصفحة أن تتسع لـ 130 بطاقة (10 أعمدة × 13 صف) • 1 صفحة"
            android:textColor="#3730A3"
            android:textSize="12sp"
            android:textStyle="bold" />

        <!-- أزرار الطباعة والملفات والسكربت -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnPreviousFiles"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:text="الملفات السابقة"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnSavePrint"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:backgroundTint="#5B46F6"
                android:text="حفظ وطباعة"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <Button
            android:id="@+id/btnExportRsc"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="8dp"
            android:text="&lt;&gt; تصدير سكربت (.rsc)" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="14dp"
            app:cardElevation="2dp">

            <TextView
                android:id="@+id/tvUmOutput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="12dp"
                android:text="جاهز لتوليد الكروت وتصدير سكربت User Manager."
                android:textColor="#1E293B"
                android:textIsSelectable="true"
                android:textSize="12sp" />
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</ScrollView>
